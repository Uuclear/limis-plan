# MatLIMS 环境变量配置模板
# 复制为 .env 并填入实际值
# cp .env.example .env

# ==========================================
# 应用配置
# ==========================================
APP_NAME=MatLIMS
APP_VERSION=1.0.0
SECRET_KEY=CHANGE-THIS-TO-A-SECURE-SECRET-KEY-MIN-32-CHARS

# ==========================================
# 数据库 (PostgreSQL 16)
# ==========================================
DATABASE_URL=postgresql+asyncpg://lims:lims_password@localhost:5432/lims_db
DATABASE_URL_SYNC=postgresql://lims:lims_password@localhost:5432/lims_db
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ==========================================
# Redis
# ==========================================
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6379/1
REDIS_WS_URL=redis://localhost:6379/2

# ==========================================
# 文件存储
# ==========================================
FILE_STORAGE_BASE_DIR=/data/lims/files

# ==========================================
# 会话 & CSRF
# ==========================================
SESSION_MAX_AGE=604800  # 7天
CSRF_SECRET=CHANGE-THIS-TO-ANOTHER-SECRET

# ==========================================
# 日志
# ==========================================
LOG_LEVEL=INFO
LOG_FILE=/var/log/lims/app.log

# ==========================================
# Celery
# ==========================================
CELERY_BROKER_URL=redis://localhost:6379/3
CELERY_RESULT_BACKEND=redis://localhost:6379/4
